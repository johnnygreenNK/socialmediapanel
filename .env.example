# Copy to .env and fill in. Never commit the real .env.

PORT=8080

# Where account browser profiles (your logged-in sessions) are stored.
DATA_DIR=./data

# PIN — required when the panel is exposed beyond 127.0.0.1 (Cloudflare Tunnel,
# own domain, etc.). Any string works; use something long and random.
# Leave empty only if the server is truly local-only.
# PIN=your-secret-pin-here

# Set to 'chrome' to use the installed Google Chrome instead of Playwright's
# bundled Chromium. Recommended for Gmail/Google accounts (avoids the
# "This browser may not be secure" block). Requires Chrome installed on the server.
# BROWSER_CHANNEL=chrome

# Bind address. Change to 0.0.0.0 when behind a reverse proxy (Caddy, nginx)
# or Cloudflare Tunnel running on the same machine.
# HOST=0.0.0.0
